{
    "Variable Declaration (Immutable)": {
        "prefix": "val",
        "body": [
            "val ${1:name} := ${2:value}"
        ],
        "description": "Declare an immutable variable with type inference"
    },
    "Variable Declaration (Mutable)": {
        "prefix": "var",
        "body": [
            "var ${1:name} := ${2:value}"
        ],
        "description": "Declare a mutable variable with type inference"
    },
    "Typed Variable Declaration": {
        "prefix": "valt",
        "body": [
            "val ${1:name}: ${2:Type} = ${3:value}"
        ],
        "description": "Declare a variable with explicit type"
    },
    "Function Declaration": {
        "prefix": "fun",
        "body": [
            "fun ${1:functionName}(${2:params}): ${3:ReturnType} {",
            "    ${4:// function body}",
            "    return ${5:result}",
            "}"
        ],
        "description": "Create a function with return type"
    },
    "Void Function": {
        "prefix": "funv",
        "body": [
            "fun ${1:functionName}(${2:params}) {",
            "    ${3:// function body}",
            "}"
        ],
        "description": "Create a void function"
    },
    "If Statement": {
        "prefix": "if",
        "body": [
            "if (${1:condition}) {",
            "    ${2:// code}",
            "}"
        ],
        "description": "If statement"
    },
    "If-Else Statement": {
        "prefix": "ife",
        "body": [
            "if (${1:condition}) {",
            "    ${2:// if true}",
            "} else {",
            "    ${3:// if false}",
            "}"
        ],
        "description": "If-else statement"
    },
    "For-In Loop": {
        "prefix": "forin",
        "body": [
            "for (${1:item} in ${2:collection}) {",
            "    ${3:// loop body}",
            "}"
        ],
        "description": "For-in loop over collection"
    },
    "While Loop": {
        "prefix": "while",
        "body": [
            "for (${1:condition}) {",
            "    ${2:// loop body}",
            "}"
        ],
        "description": "While-style loop"
    },
    "Import Statement": {
        "prefix": "import",
        "body": [
            "import { ${1:items} } from \"${2:module}\""
        ],
        "description": "Import from module"
    },
    "Type Definition": {
        "prefix": "def",
        "body": [
            "def ${1:TypeName} = {",
            "    ${2:field}: ${3:Type}",
            "}"
        ],
        "description": "Define a custom type"
    },
    "Array Declaration": {
        "prefix": "arr",
        "body": [
            "val ${1:name} := [${2:elements}]"
        ],
        "description": "Declare an array"
    },
    "Print Statement": {
        "prefix": "print",
        "body": [
            "print(${1:value})"
        ],
        "description": "Print to console"
    },
    "Main Function": {
        "prefix": "main",
        "body": [
            "import { print } from \"bolt:stdio\"",
            "",
            "fun main() {",
            "    ${1:// main code}",
            "}"
        ],
        "description": "Main function with imports"
    },
    "Test Function": {
        "prefix": "test",
        "body": [
            "fun test_${1:name}() {",
            "    // Arrange",
            "    ${2:// setup}",
            "    ",
            "    // Act",
            "    ${3:// action}",
            "    ",
            "    // Assert",
            "    ${4:// verification}",
            "}"
        ],
        "description": "Test function template"
    }
}