{
  "name": "bolt-language",
  "displayName": "Bolt Language",
  "description": "Advanced IntelliSense with type-aware hover, completion, and error checking for the Bolt programming language with native C modules, file I/O, and string utilities",
  "version": "0.6.0",
  "publisher": "bolt-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "bolt",
    "language",
    "generic types",
    "arrays",
    "typescript-inspired",
    "compiled",
    "systems programming",
    "native modules",
    "file io",
    "string utilities",
    "type checking",
    "intellisense",
    "language server",
    "hover information",
    "auto completion"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sebber/bolt-lang.git"
  },
  "bugs": {
    "url": "https://github.com/sebber/bolt-lang/issues"
  },
  "homepage": "https://github.com/sebber/bolt-lang#readme",
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:bolt"
  ],
  "dependencies": {
    "vscode-languageclient": "^7.0.0"
  },
  "scripts": {
    "test": "echo 'No tests yet'",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "contributes": {
    "languages": [
      {
        "id": "bolt",
        "aliases": ["Bolt", "bolt"],
        "extensions": [".bolt"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bolt",
        "scopeName": "source.bolt",
        "path": "./syntaxes/bolt.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "bolt.restartLSP",
        "title": "Restart Bolt Language Server",
        "category": "Bolt"
      },
      {
        "command": "bolt.showLSPOutput",
        "title": "Show Bolt LSP Output",
        "category": "Bolt"
      },
      {
        "command": "bolt.compileFile",
        "title": "Compile Current File",
        "category": "Bolt"
      },
      {
        "command": "bolt.runFile",
        "title": "Compile and Run Current File",
        "category": "Bolt"
      },
      {
        "command": "bolt.showTypeInfo",
        "title": "Show Type Information",
        "category": "Bolt"
      }
    ],
    "snippets": [
      {
        "language": "bolt",
        "path": "./snippets/bolt.json"
      }
    ],
    "keybindings": [
      {
        "command": "bolt.compileFile",
        "key": "F5",
        "when": "editorTextFocus && resourceExtname == .bolt"
      },
      {
        "command": "bolt.runFile",
        "key": "Ctrl+F5",
        "when": "editorTextFocus && resourceExtname == .bolt"
      },
      {
        "command": "bolt.showTypeInfo",
        "key": "Ctrl+K Ctrl+I",
        "when": "editorTextFocus && resourceExtname == .bolt"
      }
    ]
  }
}