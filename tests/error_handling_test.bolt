import { print } from "bolt:stdio"

// Example: File reading with error handling
fun readFile(path: String): Result<String, String> {
    if (path == "missing.txt") {
        return Failure("File not found")
    }
    return Success("File contents here")
}

fun divide(a: Integer, b: Integer): Result<Integer, String> {
    if (b == 0) {
        return Failure("Division by zero")
    }
    return Success(a / b)
}

fun main() {
    // Test file reading
    val fileResult := readFile("data.txt")
    match fileResult {
        Success(content) => print("File content: " + content),
        Failure(error) => print("File error: " + error)
    }
    
    // Test division
    val divResult := divide(10, 2)
    match divResult {
        Success(value) => print("Division result: " + toString(value)),
        Failure(error) => print("Math error: " + error)
    }
    
    // Test error case
    val errorResult := divide(10, 0)
    match errorResult {
        Success(value) => print("Unexpected success: " + toString(value)),
        Failure(error) => print("Expected error: " + error)
    }
}