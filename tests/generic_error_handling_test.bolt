import { print } from "bolt:stdio"

type Array<T> = {
    data: ^T,
    length: Integer,
    capacity: Integer
}

type Option<T> = {
    value: T,
    hasValue: Bool
}

print("Testing generic error handling patterns:")

val number: Integer = 100
val result: Option<Integer> = Option<Integer> {
    value: number,
    hasValue: true
}

print("Result value:")
print(result.value)

if (!result.hasValue) {
    print("No value")
} else {
    print("Has value")
}

val emptyResult: Option<Integer> = Option<Integer> {
    value: 0,
    hasValue: false
}

print("Empty result:")
if (!emptyResult.hasValue) {
    print("Empty detected")
} else {
    print("Has value")
}